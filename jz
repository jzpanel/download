run_option() {
    case "$1" in
        1|restart)    do_restart ;;
        2|stop)       do_stop ;;
        3|start)      do_start ;;
        4|log)        do_log ;;
        5|info)       do_info ;;
        6|status)     do_status ;;
        7)            do_reset_credentials ;;
        8)            do_change_port ;;
        9)            do_change_entry ;;
        10)           do_check_update ;;
        11|upgrade)   do_upgrade ;;
        12|repair)    do_repair ;;
        13|uninstall) do_uninstall ;;
        q|quit|exit|0)
            echo ""
            exit 0
            ;;
        "")
            # 空输入，重新显示菜单
            ;;
        *)
            _warn "无效选项: $1"
            ;;
    esac
}

# ═══════════════════════════════════════════════════
# 主入口
# ═══════════════════════════════════════════════════
main() {
    _check_root
    _check_installed

    # 子命令模式（jz restart / jz status 等）
    # 注意：只取 $1 作为子命令，其他参数由子命令函数通过 read 交互获取
    # （子命令不支持非交互参数传入，保持简单）
    if [ -n "${1:-}" ]; then
        run_option "$1"
        exit 0
    fi

    # 交互菜单模式
    while true; do
        show_menu
        read -rp "  请输入选项: " choice
        run_option "$choice"
        # 查看日志和退出不需要暂停
        if [ "$choice" != "4" ] && [ "$choice" != "q" ] && \
           [ "$choice" != "quit" ] && [ "$choice" != "exit" ] && \
           [ "$choice" != "0" ]; then
            echo ""
            read -rp "  按 Enter 返回菜单..." _dummy
        fi
    done
}

main "${1:-}"
